import has_datasheet
import has_designator_prefix
import has_part_picked
import is_atomic_part

component LM7805:
    """Линеен стабилизатор +5V TO-220 — захранване на ESP32."""

    trait is_atomic_part<manufacturer="HGSEMI", partnumber="LM7805CT", footprint="TO-220-3_L10.0-W4.5-P2.54-L.kicad_mod", symbol="LM7805CT_C725349.kicad_sym", model="TO-220-3_L10.0-W4.5-P2.54-L.STEP">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C725349", manufacturer="HGSEMI", partno="LM7805CT">
    trait has_designator_prefix<prefix="U">
    trait has_datasheet<datasheet="https://www.lcsc.com/datasheet/lcsc_datasheet_2008251935_HGSEMI-LM7805CT_C725349.pdf">

    # pins
    signal INPUT  ~ pin 1
    signal GND    ~ pin 2
    signal OUTPUT ~ pin 3
    signal vi  ~ INPUT
    signal gnd ~ GND
    signal vo  ~ OUTPUT
