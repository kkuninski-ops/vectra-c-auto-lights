(kicad_pcb
  (version 20221018)
  (generator pcbnew)
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user "B.Fabrication")
    (49 "F.Fab" user "F.Fabrication")
    (50 "User.1" user)
    (51 "User.2" user)
    (52 "User.3" user)
    (53 "User.4" user)
    (54 "User.5" user)
    (55 "User.6" user)
    (56 "User.7" user)
    (57 "User.8" user)
    (58 "User.9" user)
  )
  (setup
    (pad_to_mask_clearance 0.1)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (dashed_line_dash_ratio 12.000000)
      (dashed_line_gap_ratio 3.000000)
      (svgprecision 4)
      (plotframeref no)
      (viasonmask no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (pdf_front_fp_property_popups yes)
      (pdf_back_fp_property_popups yes)
      (dxfpolygonmode yes)
      (dxfimperialunits yes)
      (dxfusepcbnewfont yes)
      (psnegative no)
      (psa4output no)
      (plotreference yes)
      (plotvalue yes)
      (plotfptext yes)
      (plotinvisibletext no)
      (sketchpadsonfab no)
      (subtractmaskfromsilk no)
      (outputformat 1)
      (mirror no)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "gerbers/")
    )
  )
  (net 0 "")
  (net 1 "+12V")
  (net 2 "GND")
  (net 3 "+5V")
  (net 4 "+3V3")
  (net 5 "GPIO34_ADC")
  (net 6 "GPIO35_ACC")
  (net 7 "GPIO32_AUTO")
  (net 8 "GPIO33_UNLOCK")
  (net 9 "GPIO26_XENON")
  (net 10 "GPIO27_GABARI")
  (net 11 "GPIO14_FOG")
  (net 12 "GPIO13_ILLUM")
  (net 13 "XENON_OUT")
  (net 14 "GABARI_OUT")
  (net 15 "FOG_OUT")
  (net 16 "ILLUM_OUT")
  (net 17 "BCM_XENON")
  (net 18 "BCM_GABARI")
  (net 19 "BCM_FOG")
  (net 20 "BCM_ILLUM")
  (net 21 "KL18_CAR")
  (net 22 "AUTO_CAR")
  (net 23 "UNLOCK_CAR")
  (net 24 "VBAT_CAR")
  (net 25 "GATE_IRF")
  (net 26 "RELAY_K1_COIL_NEG")
  (net 27 "RELAY_K2_COIL_NEG")
  (net 28 "F2_OUT")
  (net 29 "F3_OUT")

  ;; ─── Board outline: 120mm × 80mm ─────────────────────────────────────────
  (gr_rect
    (start 0 0) (end 120 80)
    (stroke (width 0.05) (type solid))
    (layer "Edge.Cuts")
  )

  ;; ─── Title block comment ──────────────────────────────────────────────────
  (gr_text "Vectra C Auto Lights v1.0"
    (at 60 -5) (layer "F.SilkS")
    (effects (font (size 2 2) (thickness 0.3)))
  )
  (gr_text "ESP32 + Xenon/Relay/Illum controller"
    (at 60 -2.5) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.18)))
  )

  ;; ─── Zone: GND pour on B.Cu ───────────────────────────────────────────────
  (zone
    (net 2) (net_name "GND") (layer "B.Cu") (tstamp "zone-gnd")
    (hatch edge 0.508)
    (connect_pads (clearance 0.3))
    (min_thickness 0.25)
    (filled_areas_thickness no)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon
      (pts (xy 0.5 0.5) (xy 119.5 0.5) (xy 119.5 79.5) (xy 0.5 79.5))
    )
  )

  ;; ════════════════════════════════════════════════════════════════════
  ;;  COMPONENT PLACEMENTS
  ;;  Координати в mm; референция + footprint за всеки компонент
  ;; ════════════════════════════════════════════════════════════════════

  ;; --- J1: Power input (KL30, GND, VBAT) --------------------------------
  (footprint "Connector_JST:JST_XH_B3B-XH-A_1x03_P2.50mm_Vertical"
    (layer "F.Cu") (at 5 5) (ref "J1") (value "PWR_IN")
  )

  ;; --- J2: Car input signals ---------------------------------------------
  (footprint "Connector_JST:JST_XH_B4B-XH-A_1x04_P2.50mm_Vertical"
    (layer "F.Cu") (at 5 18) (ref "J2") (value "INPUTS")
  )

  ;; --- J3: BCM outputs (from car) ----------------------------------------
  (footprint "Connector_JST:JST_XH_B5B-XH-A_1x05_P2.50mm_Vertical"
    (layer "F.Cu") (at 5 33) (ref "J3") (value "BCM_IN")
  )

  ;; --- J4: Outputs to lights ---------------------------------------------
  (footprint "Connector_JST:JST_XH_B5B-XH-A_1x05_P2.50mm_Vertical"
    (layer "F.Cu") (at 5 50) (ref "J4") (value "LIGHTS_OUT")
  )

  ;; --- J5: ESP32 5V supply -----------------------------------------------
  (footprint "Connector_JST:JST_XH_B2B-XH-A_1x02_P2.50mm_Vertical"
    (layer "F.Cu") (at 5 65) (ref "J5") (value "ESP32_VIN")
  )

  ;; --- F1: 1A fuse (MCU supply) ------------------------------------------
  (footprint "Fuse:Fuseholder_Cylinder_5x20mm_Schurter_0031_8201_Horizontal_Open"
    (layer "F.Cu") (at 22 5) (ref "F1") (value "1A")
  )

  ;; --- F2: 15A fuse (Xenon) ----------------------------------------------
  (footprint "Fuse:Fuseholder_Cylinder_5x20mm_Schurter_0031_8201_Horizontal_Open"
    (layer "F.Cu") (at 22 14) (ref "F2") (value "15A")
  )

  ;; --- F3: 5A fuse (Relay supply) ----------------------------------------
  (footprint "Fuse:Fuseholder_Cylinder_5x20mm_Schurter_0031_8201_Horizontal_Open"
    (layer "F.Cu") (at 22 23) (ref "F3") (value "5A")
  )

  ;; --- D1: 1N4007 reverse protection ------------------------------------
  (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"
    (layer "F.Cu") (at 38 5) (ref "D1") (value "1N4007")
  )

  ;; --- D12: P6KE15A TVS -------------------------------------------------
  (footprint "Diode_THT:D_DO-201AD_P12.70mm_Horizontal"
    (layer "F.Cu") (at 38 10) (ref "D12") (value "P6KE15A")
  )

  ;; --- U2: LM7805 -------------------------------------------------------
  (footprint "Package_TO_SOT_THT:TO-220-3_Vertical"
    (layer "F.Cu") (at 50 5) (ref "U2") (value "LM7805")
  )

  ;; --- C1: 100uF electrolytic -------------------------------------------
  (footprint "Capacitor_THT:CP_Radial_D8.0mm_P3.50mm"
    (layer "F.Cu") (at 62 5) (ref "C1") (value "100uF/25V")
  )

  ;; --- C2: 100nF ceramic ------------------------------------------------
  (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P2.50mm"
    (layer "F.Cu") (at 68 5) (ref "C2") (value "100nF")
  )

  ;; --- R1, R2: Vbat divider ---------------------------------------------
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 22 35) (ref "R1") (value "47k")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 22 41) (ref "R2") (value "10k")
  )

  ;; --- OK1, OK2, OK3: Optocouplers + resistors --------------------------
  (footprint "Package_DIP:DIP-4_W7.62mm"
    (layer "F.Cu") (at 38 35) (ref "OK1") (value "PC817")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 34 32) (ref "R3") (value "4k7")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 46 32) (ref "R4") (value "10k")
  )

  (footprint "Package_DIP:DIP-4_W7.62mm"
    (layer "F.Cu") (at 38 45) (ref "OK2") (value "PC817")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 34 42) (ref "R5") (value "4k7")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 46 42) (ref "R6") (value "10k")
  )

  (footprint "Package_DIP:DIP-4_W7.62mm"
    (layer "F.Cu") (at 38 55) (ref "OK3") (value "PC817")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 34 52) (ref "R7") (value "4k7")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 46 52) (ref "R8") (value "10k")
  )

  ;; --- U1: ESP32 DevKit -------------------------------------------------
  ;; ESP32-WROOM module ~52mm × 28mm, placed centre of board
  (footprint "RF_Module:ESP32-WROOM-32"
    (layer "F.Cu") (at 75 40) (ref "U1") (value "ESP32-WROOM-32")
  )

  ;; --- Xenon MOSFET section ---------------------------------------------
  (footprint "Package_TO_SOT_THT:TO-220-3_Vertical"
    (layer "F.Cu") (at 22 58) (ref "Q1") (value "IRF4905")
  )
  (footprint "Package_TO_SOT_THT:TO-92_Inline"
    (layer "F.Cu") (at 30 58) (ref "Q2") (value "2N7000")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 22 64) (ref "R9") (value "10k")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 30 64) (ref "R10") (value "1k")
  )
  (footprint "Diode_THT:D_DO-201AD_P12.70mm_Horizontal"
    (layer "F.Cu") (at 22 70) (ref "D2") (value "1N5408")
  )
  (footprint "Diode_THT:D_DO-201AD_P12.70mm_Horizontal"
    (layer "F.Cu") (at 36 70) (ref "D3") (value "1N5408")
  )

  ;; --- Relay K1 (Gabari) ------------------------------------------------
  (footprint "Relay_THT:Relay_SPDT_SANYOU_SRD_Series_RM5"
    (layer "F.Cu") (at 55 60) (ref "K1") (value "HF32F-12V")
  )
  (footprint "Package_TO_SOT_THT:TO-92_Inline"
    (layer "F.Cu") (at 50 68) (ref "Q3") (value "BC547")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 50 73) (ref "R11") (value "1k")
  )
  (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"
    (layer "F.Cu") (at 62 68) (ref "D8") (value "1N4007")
  )
  (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"
    (layer "F.Cu") (at 62 73) (ref "D4") (value "1N4007")
  )
  (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"
    (layer "F.Cu") (at 73 73) (ref "D5") (value "1N4007")
  )

  ;; --- Relay K2 (Fog) ---------------------------------------------------
  (footprint "Relay_THT:Relay_SPDT_SANYOU_SRD_Series_RM5"
    (layer "F.Cu") (at 88 60) (ref "K2") (value "HF32F-12V")
  )
  (footprint "Package_TO_SOT_THT:TO-92_Inline"
    (layer "F.Cu") (at 83 68) (ref "Q4") (value "BC547")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 83 73) (ref "R12") (value "1k")
  )
  (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"
    (layer "F.Cu") (at 95 68) (ref "D9") (value "1N4007")
  )
  (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"
    (layer "F.Cu") (at 95 73) (ref "D6") (value "1N4007")
  )
  (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"
    (layer "F.Cu") (at 107 73) (ref "D7") (value "1N4007")
  )

  ;; --- Illumination section ---------------------------------------------
  (footprint "Package_TO_SOT_THT:TO-92_Inline"
    (layer "F.Cu") (at 108 10) (ref "Q5") (value "BC547")
  )
  (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"
    (layer "F.Cu") (at 108 16) (ref "R13") (value "1k")
  )
  (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"
    (layer "F.Cu") (at 108 22) (ref "D10") (value "1N4007")
  )
  (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"
    (layer "F.Cu") (at 108 28) (ref "D11") (value "1N4007")
  )

  ;; ─── Section labels (silkscreen) ──────────────────────────────────────
  (gr_text "POWER" (at 38 2) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2)) (justify left)))
  (gr_text "OPTO INPUTS" (at 32 29) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "ESP32" (at 73 27) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2)) (justify left)))
  (gr_text "XENON MOSFET" (at 20 55) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "GABARI RELAY" (at 49 57) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "FOG RELAY" (at 82 57) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))
  (gr_text "ILLUMINATION" (at 103 7) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left)))

  ;; ─── Mounting holes (M3, 3mm diameter) ───────────────────────────────
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu") (at 3 3) (ref "H1") (value "M3")
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu") (at 117 3) (ref "H2") (value "M3")
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu") (at 3 77) (ref "H3") (value "M3")
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu") (at 117 77) (ref "H4") (value "M3")
  )

)
